<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="robotgame.ui.MainController"
            style="-fx-background-color: #05050a;">
    <top>
        <Label text="RobotGame" style="-fx-text-fill: #ffe066; -fx-font-size: 28px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="16" bottom="8" left="16" right="16"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <StackPane>
            <!-- Tela de configuração inicial -->
            <VBox fx:id="setupPane" alignment="CENTER" spacing="12" maxWidth="320">
                <padding>
                    <Insets top="24" bottom="24" left="24" right="24"/>
                </padding>

                <Label text="Cor do robô:" style="-fx-text-fill: #dddddd;"/>
                <TextField fx:id="corField" promptText="ex: vermelho, azul, verde..."/>

                <HBox spacing="16" alignment="CENTER">
                    <VBox spacing="4" alignment="CENTER">
                        <Label text="Alimento X (0-3)" style="-fx-text-fill: #dddddd;"/>
                        <Spinner fx:id="xSpinner" editable="true" prefWidth="80"/>
                    </VBox>
                    <VBox spacing="4" alignment="CENTER">
                        <Label text="Alimento Y (0-3)" style="-fx-text-fill: #dddddd;"/>
                        <Spinner fx:id="ySpinner" editable="true" prefWidth="80"/>
                    </VBox>
                </HBox>

                <Button text="Iniciar" onAction="#iniciarJogo" defaultButton="true"
                        style="-fx-font-size: 14px; -fx-padding: 8 24 8 24;"/>

                <Label fx:id="setupErrorLabel" style="-fx-text-fill: #ff5555;" wrapText="true"/>
            </VBox>

            <!-- Tela do jogo -->
            <VBox fx:id="gamePane" alignment="CENTER" spacing="12" visible="false" managed="false">
                <padding>
                    <Insets top="12" bottom="24" left="24" right="24"/>
                </padding>

                <Label fx:id="statusLabel" style="-fx-text-fill: #eeeeee; -fx-font-size: 14px;" wrapText="true"/>

                <GridPane fx:id="boardGrid" alignment="CENTER" hgap="2" vgap="2"/>

                <Label fx:id="statsLabel" style="-fx-text-fill: #66ffcc; -fx-font-size: 13px;"/>

                <Button text="Novo jogo" onAction="#novoJogo"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
